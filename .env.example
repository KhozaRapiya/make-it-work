# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://www.makeitwork.co.za

# ---- Contact details (optional: the real details are already set in src/lib/site.ts) ----
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_BUSINESS_HOURS=
# WhatsApp number in international format, digits only, e.g. 27821234567
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---- Social links ----
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=

# ---- Enquiry / quote form delivery (Resend, server-side only) ----
RESEND_API_KEY=
# Where enquiries are sent (comma-separated for several)
ENQUIRY_TO_EMAIL=info@makeitwork.co.za
# A sender on the domain verified in Resend
ENQUIRY_FROM_EMAIL=Make IT Work Website <website@makeitwork.co.za>

# ---- AI chatbot (server-side only, never exposed to the browser) ----
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
CHAT_MODEL=

# ---- Analytics (loads only after cookie consent) ----
NEXT_PUBLIC_GA_ID=
